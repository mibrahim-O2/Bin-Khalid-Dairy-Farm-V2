# Copy this file to .env.local and fill in real values.
# .env.local is git-ignored — never commit real secrets.

# --- Firebase client config ---
# Firebase Console -> Project Settings -> General -> Your apps -> Web app -> SDK setup and config
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# --- Firebase Admin SDK (server-only, never expose to client) ---
# Firebase Console -> Project Settings -> Service Accounts -> Generate new private key
# Paste values from the downloaded JSON file. Keep FIREBASE_ADMIN_PRIVATE_KEY quoted with \n line breaks intact.
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY=

# --- Owner identification ---
# Identifies the single "Owner" account, who alone can approve pending
# users. NOT a secret/password — nothing is ever typed or compared against
# these as a credential; they just tell the server which already-signed-in
# account is the owner. Set one or both (UID is the more robust match; email
# is a convenient fallback before you know the account's UID).
OWNER_UID=
OWNER_EMAIL=

# --- Supabase (Postgres database) ---
# Supabase Dashboard -> Project Settings -> Data API for the URL/anon key,
# -> API Keys for the service_role key (server-only, never expose to
# client — though nothing in this app calls Supabase's REST API with it
# today; see src/lib/db/README.md).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Supabase Dashboard -> Project Settings -> Database -> Connection string
# -> Transaction pooler (port 6543 — required for a serverless deploy
# target like Vercel; see src/lib/db/client.ts's `prepare: false`). If your
# password contains characters like @, :, or /, percent-encode them (@ ->
# %40) or the URL parser can't tell where the password ends.
DATABASE_URL=
