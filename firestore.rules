rules_version = '2';

// Deny-all default. Every other collection is opened up explicitly as it's
// introduced. See SYSTEM_ARCHITECTURE.md for the full trust boundary this
// encodes:
//   - Non-financial master data: client writes allowed, admin-authorized only.
//   - Financial collections: `allow write: if false` always. All writes go
//     through Server Actions using the Admin SDK, which bypasses these rules.
service cloud.firestore {
  match /databases/{database}/documents {

    // Authorization gate: `active: true` on the custom claim, checked
    // directly off the Auth token (not a get() call) for latency, matching
    // getServerSession() on the server side.
    function isActiveAdmin() {
      return request.auth != null && request.auth.token.active == true;
    }

    // /users/{uid}: self-read only. Writes happen only through the admin
    // script / future Server Actions.
    match /users/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }

    // --- Non-financial master data (Phase 3) ---
    match /customers/{customerId} {
      allow read, write: if isActiveAdmin();
    }

    match /products/{productId} {
      allow read, write: if isActiveAdmin();
    }

    match /customerRates/{rateId} {
      allow read, write: if isActiveAdmin();

      match /history/{historyId} {
        allow read, write: if isActiveAdmin();
      }
    }

    // --- Financial collections (Phase 3): read for authorized admins,
    // write denied entirely — only Server Actions using the Admin SDK
    // (which bypasses these rules) may create ledger transactions.
    match /customerLedgerTransactions/{transactionId} {
      allow read: if isActiveAdmin();
      allow write: if false;
    }

    // --- Bills (Phase 4) ---
    // A draft bill isn't a posted financial record yet — no ledger entry
    // exists for it — so it's fine for an admin to create/edit/delete it
    // directly, same trust level as other master data. The moment a bill
    // stops being a draft (finalized or void), it becomes a financial
    // record and must never be touched by a direct client write again —
    // enforced here too (defense in depth), not just in application code.
    match /bills/{billId} {
      allow read: if isActiveAdmin();
      allow create: if isActiveAdmin() && request.resource.data.status == 'draft';
      allow update: if isActiveAdmin()
        && resource.data.status == 'draft'
        && request.resource.data.status == 'draft';
      allow delete: if isActiveAdmin() && resource.data.status == 'draft';
    }

    // Sequential bill-number counters — never client-writable, to avoid
    // duplicate numbers under concurrent use. Only the finalize Server
    // Action (Admin SDK) increments these, inside a transaction.
    match /counters/{counterId} {
      allow read, write: if false;
    }

    // Deny everything else by default until a phase explicitly opens it up.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
