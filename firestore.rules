rules_version = '2';

// Deny-all. Every domain that used to live in Firestore (customers,
// products, bills, suppliers, purchases, employees, payments, ledgers,
// statements, users) has migrated to Postgres — see src/lib/db/README.md
// for the full migration record. The app no longer reads or writes
// Firestore data anywhere; only Firebase Authentication itself (which
// doesn't go through these rules) is still in use. This file is kept
// deny-all rather than deleted so a `firebase deploy` never accidentally
// re-opens a collection that predates the migration.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
